# ============================================================
# Oil Spill Detection Backend - Environment Variables
# ============================================================

# Supabase (REQUIRED)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key
SUPABASE_BUCKET=sar-uploads

# Model
MODEL_PATH=best_oil_spill_unet.pth
THRESHOLD=0.4
MIN_AREA_PIXELS=100

# API
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
